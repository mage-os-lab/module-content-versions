<?xml version="1.0"?>
<form xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">mageos_versions_update_form.update_form_data_source</item>
        </item>
        <item name="label" xsi:type="string" translate="true">Planned Content Version</item>
        <item name="template" xsi:type="string">templates/form/collapsible</item>
    </argument>
    <settings>
        <buttons>
            <button name="back">
                <url path="*/*/"/>
                <class>back</class>
                <label translate="true">Back</label>
            </button>
            <button name="save" class="MageOS\ContentVersions\Block\Adminhtml\SaveButton"/>
        </buttons>
        <namespace>mageos_versions_update_form</namespace>
        <dataScope>data</dataScope>
        <deps>
            <dep>mageos_versions_update_form.update_form_data_source</dep>
        </deps>
    </settings>
    <dataSource name="update_form_data_source">
        <argument name="data" xsi:type="array">
            <item name="js_config" xsi:type="array">
                <item name="component" xsi:type="string">Magento_Ui/js/form/provider</item>
            </item>
        </argument>
        <settings>
            <submitUrl path="mageos_versions/update/save"/>
        </settings>
        <dataProvider class="MageOS\ContentVersions\Model\Update\DataProvider" name="update_form_data_source">
            <settings>
                <requestFieldName>update_id</requestFieldName>
                <primaryFieldName>update_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>
    <fieldset name="schedule" sortOrder="10">
        <settings>
            <label translate="true">Schedule</label>
        </settings>
        <field name="update_id" sortOrder="1" formElement="input">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="source" xsi:type="string">update</item>
                </item>
            </argument>
            <settings>
                <dataType>text</dataType>
                <label translate="true">ID</label>
                <dataScope>update_id</dataScope>
                <visible>false</visible>
            </settings>
        </field>
        <field name="entity_type" sortOrder="2" formElement="input">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="source" xsi:type="string">update</item>
                </item>
            </argument>
            <settings>
                <dataType>text</dataType>
                <label translate="true">Type</label>
                <dataScope>entity_type</dataScope>
                <visible>false</visible>
            </settings>
        </field>
        <field name="entity_id" sortOrder="3" formElement="input">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="source" xsi:type="string">update</item>
                </item>
            </argument>
            <settings>
                <dataType>text</dataType>
                <label translate="true">Content ID</label>
                <dataScope>entity_id</dataScope>
                <visible>false</visible>
            </settings>
        </field>
        <field name="name" sortOrder="10" formElement="input">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="source" xsi:type="string">update</item>
                </item>
            </argument>
            <settings>
                <dataType>text</dataType>
                <label translate="true">Update Name</label>
                <dataScope>name</dataScope>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                </validation>
            </settings>
        </field>
        <field name="start_time" sortOrder="20" formElement="date">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="source" xsi:type="string">update</item>
                </item>
            </argument>
            <settings>
                <dataType>text</dataType>
                <label translate="true">Start Date</label>
                <dataScope>start_time</dataScope>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                </validation>
            </settings>
            <formElements>
                <date>
                    <settings>
                        <options>
                            <option name="showsTime" xsi:type="boolean">true</option>
                        </options>
                    </settings>
                </date>
            </formElements>
        </field>
        <field name="end_time" sortOrder="30" formElement="date">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="source" xsi:type="string">update</item>
                </item>
            </argument>
            <settings>
                <dataType>text</dataType>
                <label translate="true">End Date</label>
                <dataScope>end_time</dataScope>
                <notice translate="true">Leave empty for a permanent change. With an end date, the previous content comes back at that time.</notice>
            </settings>
            <formElements>
                <date>
                    <settings>
                        <options>
                            <option name="showsTime" xsi:type="boolean">true</option>
                        </options>
                    </settings>
                </date>
            </formElements>
        </field>
    </fieldset>
    <fieldset name="content" sortOrder="20">
        <settings>
            <label translate="true">Content During the Update</label>
        </settings>
        <field name="title" sortOrder="10" formElement="input">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="source" xsi:type="string">update</item>
                </item>
            </argument>
            <settings>
                <dataType>text</dataType>
                <label translate="true">Title</label>
                <dataScope>title</dataScope>
                <notice translate="true">Only the fields you change here are replaced. The others keep the content of the page or block, including later edits.</notice>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                </validation>
            </settings>
        </field>
        <field name="content_heading" sortOrder="20" formElement="input">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="source" xsi:type="string">update</item>
                </item>
            </argument>
            <settings>
                <dataType>text</dataType>
                <label translate="true">Content Heading</label>
                <dataScope>content_heading</dataScope>
            </settings>
        </field>
        <field name="content" template="ui/form/field" sortOrder="30" formElement="wysiwyg">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="source" xsi:type="string">update</item>
                </item>
            </argument>
            <settings>
                <additionalClasses>
                    <class name="admin__field-wide">true</class>
                </additionalClasses>
                <label/>
                <dataScope>content</dataScope>
            </settings>
            <formElements>
                <wysiwyg>
                    <settings>
                        <wysiwyg>true</wysiwyg>
                    </settings>
                </wysiwyg>
            </formElements>
        </field>
        <field name="meta_title" sortOrder="40" formElement="input">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="source" xsi:type="string">update</item>
                </item>
            </argument>
            <settings>
                <dataType>text</dataType>
                <label translate="true">Meta Title</label>
                <dataScope>meta_title</dataScope>
            </settings>
        </field>
        <field name="meta_keywords" sortOrder="50" formElement="textarea">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="source" xsi:type="string">update</item>
                </item>
            </argument>
            <settings>
                <dataType>text</dataType>
                <label translate="true">Meta Keywords</label>
                <dataScope>meta_keywords</dataScope>
            </settings>
        </field>
        <field name="meta_description" sortOrder="60" formElement="textarea">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="source" xsi:type="string">update</item>
                </item>
            </argument>
            <settings>
                <dataType>text</dataType>
                <label translate="true">Meta Description</label>
                <dataScope>meta_description</dataScope>
            </settings>
        </field>
    </fieldset>
</form>
