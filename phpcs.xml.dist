<?xml version="1.0"?>
<ruleset name="Module">
    <description>Magento coding standard for this module</description>
    <file>.</file>
    <exclude-pattern>vendor/*</exclude-pattern>
    <arg value="sp"/>
    <rule ref="Magento2"/>
    <!-- PSR-12 / PER style: (int) $value -->
    <rule ref="Generic.Formatting.SpaceAfterCast"/>
    <!-- after the Magento2 rule, which sets its own extension list -->
    <arg name="extensions" value="php,phtml"/>
    <!-- Pure rules with no dependencies, nothing to intercept, unit tested without DI: the date-range and
         changed-field rules of Scheduler, the link signature of Preview, the month grid of Calendar, the revision
         snapshot and comparison of Revisions -->
    <rule ref="Magento2.Functions.StaticFunction">
        <exclude-pattern>Model/Calendar.php</exclude-pattern>
        <exclude-pattern>Model/Revisions.php</exclude-pattern>
        <exclude-pattern>Model/Scheduler.php</exclude-pattern>
        <exclude-pattern>Model/Preview.php</exclude-pattern>
    </rule>
</ruleset>
